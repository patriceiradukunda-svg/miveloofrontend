# Backend API (trusted server). Leave empty to run the UI with clearly-labelled SAMPLE data.
API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000, https://miveloo-backend.onrender.com

# DEMO MODE: lets you explore every workspace with sample data and an UNSIGNED cookie.
# It is NOT a security mechanism. Defaults to ON when unset and API_URL is empty; ignored when API_URL is set.
# Set to "false" to switch demo logins off (the public site keeps working).
# DEMO_MODE=true   # unset = ON when no API_URL; "false" turns demo logins off

# Only genuine, published contact details are rendered. Leave blank until they exist.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# Miveloo live backend (public). Set to turn live catalogue, prices, forecasts, login, photos and orders ON; leave empty for labelled sample data.
NEXT_PUBLIC_API_URL=https://miveloo-backend.onrender.com
